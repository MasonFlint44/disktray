<Project Sdk="Microsoft.NET.Sdk">
  <!-- WPF tray app: icons, flyout, Settings, Clean up, toasts. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>DiskTray</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- LibraryImport generates unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DiskTray.Core/DiskTray.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
  </ItemGroup>
</Project>
