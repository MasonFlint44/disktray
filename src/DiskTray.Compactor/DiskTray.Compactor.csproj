<Project Sdk="Microsoft.NET.Sdk">
  <!-- Small elevated helper: compacts the VHDX paths it is given once the app says WSL is shut down, and reports back over a pipe. -->
  <PropertyGroup>
    <!-- No console window; it talks to the app over a named pipe. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>DiskTray.Compactor</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- LibraryImport generates unsafe marshalling code, and the compact runs on an OVERLAPPED. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Compiled ahead of time to a native exe. It runs as admin, and a .NET runtime there
         would honour environment settings anything running as the user can change, such
         as ones that load a profiler or startup hook into it. A native exe has neither.
         Needs Windows and the C++ build tools to publish, so the GitHub Actions build makes
         the installer's copy; development copies publish with PublishAot=false. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DiskTray.Core/DiskTray.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The pipe, path and account checks and the compact are tested on Windows. -->
    <InternalsVisibleTo Include="DiskTray.Windows.Tests" />
  </ItemGroup>
</Project>
