<UserControl x:Class="DiskTray.App.FlyoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:DiskTray.App"
             xmlns:flyout="clr-namespace:DiskTray.Core.Flyout;assembly=DiskTray.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance flyout:FlyoutModel}"
             Width="400"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <UserControl.Resources>
    <local:RgbBrushConverter x:Key="Brush" />
    <local:VisibleWhenSetConverter x:Key="VisibleWhenSet" />
    <local:SeverityConverter x:Key="Severity" />
    <Style x:Key="Secondary" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Divider" TargetType="Border">
      <Setter Property="Height" Value="1" />
      <Setter Property="Margin" Value="0,16,0,0" />
      <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
    </Style>
  </UserControl.Resources>

  <StackPanel Margin="20">
    <Grid>
      <StackPanel>
        <TextBlock Text="Disk usage" FontSize="15" FontWeight="SemiBold" />
        <TextBlock Text="{Binding DriveLine}" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
      </StackPanel>
      <ui:Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="36" Height="36" Padding="0"
                 Appearance="Transparent" BorderThickness="0" Icon="{ui:SymbolIcon Settings24}"
                 ToolTip="Settings" AutomationProperties.Name="Settings" Click="OnSettingsClick" />
    </Grid>

    <ItemsControl ItemsSource="{Binding Banners}" Focusable="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="flyout:FlyoutBanner">
          <ui:InfoBar Margin="0,12,0,0" IsOpen="True" IsClosable="False" Title=""
                      Message="{Binding Text}" Severity="{Binding Level, Converter={StaticResource Severity}}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Grid Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="128" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Grid Width="128" Height="128" VerticalAlignment="Top"
            AutomationProperties.Name="{Binding DonutDescription}">
        <local:DonutChart Chart="{Binding Donut}" />
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="{Binding FreeSize}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="free" Style="{StaticResource Secondary}" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>

      <ItemsControl Grid.Column="2" ItemsSource="{Binding Legend}" VerticalAlignment="Center" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="flyout:LegendItem">
            <Grid Margin="0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Border Width="10" Height="10" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                      Background="{Binding Color, Converter={StaticResource Brush}}"
                      BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
              <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2" Text="{Binding Size}" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" />
              <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Detail}" Style="{StaticResource Secondary}"
                         Margin="0,1,0,0" Visibility="{Binding Detail, Converter={StaticResource VisibleWhenSet}}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>

    <TextBlock Text="Lighter shade = space a disk file is holding but not using." Style="{StaticResource Secondary}"
               Margin="0,16,0,0" Visibility="{Binding ShowsReclaimable, Converter={StaticResource VisibleWhenSet}}" />

    <StackPanel Visibility="{Binding ReclaimableTotal, Converter={StaticResource VisibleWhenSet}}">
      <Border Style="{StaticResource Divider}" />
      <Grid Margin="0,16,0,0">
        <StackPanel VerticalAlignment="Bottom">
          <TextBlock Text="Reclaimable by compacting" FontSize="13" />
          <TextBlock Text="{Binding ReclaimableBreakdown}" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
        </StackPanel>
        <TextBlock Text="{Binding ReclaimableTotal}" FontSize="24" FontWeight="SemiBold"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" />
      </Grid>
    </StackPanel>

    <Border Style="{StaticResource Divider}" />
    <TextBlock Text="{Binding Footer}" Style="{StaticResource Secondary}" Margin="0,12,0,0"
               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
  </StackPanel>
</UserControl>
