<Project Sdk="Microsoft.NET.Sdk">
  <!-- Small programs the Windows tests run, copied into a test's own folder:
       relay stands in for DiskTray.exe beside a copy of the Compactor, which only takes
       requests from the DiskTray.exe beside it; linger is something a program starts and
       leaves running, under a name a test can find it by. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
