<UserControl x:Class="DiskTray.App.FlyoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:DiskTray.App"
             xmlns:flyout="clr-namespace:DiskTray.Core.Flyout;assembly=DiskTray.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance flyout:FlyoutModel}"
             Width="400"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <UserControl.Resources>
    <local:VisibleWhenSetConverter x:Key="VisibleWhenSet" />
    <local:SeverityConverter x:Key="Severity" />
    <Style x:Key="Secondary" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Divider" TargetType="Border">
      <Setter Property="Height" Value="1" />
      <Setter Property="Margin" Value="0,16,0,0" />
      <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
    </Style>
  </UserControl.Resources>

  <StackPanel Margin="20">
    <Grid>
      <StackPanel>
        <TextBlock Text="Disk usage" FontSize="15" FontWeight="SemiBold" />
        <TextBlock Text="{Binding DriveLine}" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
      </StackPanel>
      <ui:Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="36" Height="36" Padding="0"
                 Appearance="Transparent" BorderThickness="0" Icon="{ui:SymbolIcon Settings24}"
                 ToolTip="Settings" AutomationProperties.Name="Settings" Click="OnSettingsClick" />
    </Grid>

    <ItemsControl ItemsSource="{Binding Banners}" Focusable="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="flyout:FlyoutBanner">
          <ui:InfoBar Margin="0,12,0,0" IsOpen="True" IsClosable="False" Title=""
                      Message="{Binding Text}" Severity="{Binding Level, Converter={StaticResource Severity}}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Border x:Name="CleanupStatus" Margin="0,12,0,0" Padding="12,10" CornerRadius="6" Visibility="Collapsed"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" />
        <TextBlock x:Name="CleanupText" Grid.Column="1" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
        <ui:Button x:Name="CancelCleanup" Grid.Column="2" Content="Cancel" Margin="10,0,0,0" Padding="10,4" FontSize="12"
                   Click="OnCancelCleanupClick" Visibility="Collapsed" />
      </Grid>
    </Border>

    <local:DriveBreakdown Margin="0,16,0,0" />

    <TextBlock Text="Lighter shade = space a disk file is holding but not using." Style="{StaticResource Secondary}"
               Margin="0,16,0,0" Visibility="{Binding ShowsReclaimable, Converter={StaticResource VisibleWhenSet}}" />

    <StackPanel Visibility="{Binding ShowsLargeFiles, Converter={StaticResource VisibleWhenSet}}">
      <Border Style="{StaticResource Divider}" />
      <TextBlock Text="Other large files" FontSize="13" Margin="0,16,0,0" />
      <TextBlock Text="{Binding LargeFilesNote}" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
      <ItemsControl ItemsSource="{Binding LargeFiles}" Focusable="False" Margin="0,4,0,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="flyout:LargeFileLine">
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" ToolTip="{Binding Path}">
                <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Folder}" Style="{StaticResource Secondary}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding Size}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,4,0" />
              <ui:Button Grid.Column="2" Width="32" Height="32" Padding="0" Appearance="Transparent" BorderThickness="0"
                         Icon="{ui:SymbolIcon Pin24}" Tag="{Binding Path}" Click="OnPinClick" IsEnabled="{Binding CanPin}"
                         ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Pin to the tray">
                <ui:Button.Style>
                  <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                    <Setter Property="ToolTip" Value="Pin to the tray" />
                    <Style.Triggers>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="ToolTip" Value="All 3 tray icons are in use. Remove one in Settings to pin this." />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </ui:Button.Style>
              </ui:Button>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <StackPanel Visibility="{Binding ReclaimableTotal, Converter={StaticResource VisibleWhenSet}}">
      <Border Style="{StaticResource Divider}" />
      <Grid Margin="0,16,0,0">
        <StackPanel VerticalAlignment="Bottom">
          <TextBlock Text="Reclaimable by compacting" FontSize="13" />
          <TextBlock Text="{Binding ReclaimableBreakdown}" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
        </StackPanel>
        <TextBlock Text="{Binding ReclaimableTotal}" FontSize="24" FontWeight="SemiBold"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" />
      </Grid>
    </StackPanel>

    <Border Style="{StaticResource Divider}" />
    <Grid Margin="0,12,0,0">
      <TextBlock Text="{Binding Footer}" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,110,0"
                 Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
      <ui:Button x:Name="CleanupButton" Content="Clean up…" HorizontalAlignment="Right" Padding="12,5"
                 Click="OnCleanupClick" />
    </Grid>
  </StackPanel>
</UserControl>
