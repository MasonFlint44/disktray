<ui:FluentWindow x:Class="DiskTray.App.ColorPickerWindow"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Pick a color"
                 Width="440"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 FontFamily="Segoe UI Variable Text, Segoe UI"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar x:Name="TitleBar" Title="Pick a color" ShowMaximize="False" ShowMinimize="False" />

    <StackPanel Grid.Row="1" Margin="20,8,20,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="20" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Saturation left to right, value top to bottom, for the hue picked beside it. -->
        <Grid x:Name="ShadeArea" Width="220" Height="170" Cursor="Cross" ClipToBounds="True"
              MouseLeftButtonDown="OnShadeDown" MouseMove="OnShadeMove" MouseLeftButtonUp="OnAreaUp"
              AutomationProperties.Name="Shade">
          <Rectangle x:Name="HueFill" RadiusX="4" RadiusY="4" />
          <Rectangle RadiusX="4" RadiusY="4">
            <Rectangle.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="White" Offset="0" />
                <GradientStop Color="#00FFFFFF" Offset="1" />
              </LinearGradientBrush>
            </Rectangle.Fill>
          </Rectangle>
          <Rectangle RadiusX="4" RadiusY="4">
            <Rectangle.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#00000000" Offset="0" />
                <GradientStop Color="Black" Offset="1" />
              </LinearGradientBrush>
            </Rectangle.Fill>
          </Rectangle>
          <Canvas>
            <Ellipse x:Name="ShadeThumb" Width="14" Height="14" Stroke="White" StrokeThickness="2" IsHitTestVisible="False">
              <Ellipse.Effect>
                <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.8" />
              </Ellipse.Effect>
            </Ellipse>
          </Canvas>
        </Grid>

        <Grid x:Name="HueArea" Grid.Column="2" Width="22" Height="170" Cursor="Hand" ClipToBounds="True"
              MouseLeftButtonDown="OnHueDown" MouseMove="OnHueMove" MouseLeftButtonUp="OnAreaUp"
              AutomationProperties.Name="Hue">
          <Rectangle RadiusX="4" RadiusY="4">
            <Rectangle.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF0000" Offset="0" />
                <GradientStop Color="#FFFF00" Offset="0.1667" />
                <GradientStop Color="#00FF00" Offset="0.3333" />
                <GradientStop Color="#00FFFF" Offset="0.5" />
                <GradientStop Color="#0000FF" Offset="0.6667" />
                <GradientStop Color="#FF00FF" Offset="0.8333" />
                <GradientStop Color="#FF0000" Offset="1" />
              </LinearGradientBrush>
            </Rectangle.Fill>
          </Rectangle>
          <Canvas>
            <Border x:Name="HueThumb" Width="22" Height="6" CornerRadius="3" BorderBrush="White" BorderThickness="2" IsHitTestVisible="False">
              <Border.Effect>
                <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.8" />
              </Border.Effect>
            </Border>
          </Canvas>
        </Grid>

        <StackPanel Grid.Column="4">
          <TextBlock Text="In the tray" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <Border Margin="0,6,0,0" Padding="8" CornerRadius="6" HorizontalAlignment="Left" Background="#202020">
            <StackPanel Orientation="Horizontal">
              <Image x:Name="PreviewSmall" Width="24" Height="24" RenderOptions.BitmapScalingMode="NearestNeighbor" VerticalAlignment="Center" />
              <Image x:Name="PreviewLarge" Width="64" Height="64" Margin="12,0,0,0" />
            </StackPanel>
          </Border>
          <Label Content="Hex" Target="{Binding ElementName=Hex}" Margin="0,12,0,4" Padding="0" FontSize="12" />
          <ui:TextBox x:Name="Hex" Width="120" HorizontalAlignment="Left" MaxLength="7" TextChanged="OnHexChanged"
                      FontFamily="Cascadia Mono, Consolas" />
        </StackPanel>
      </Grid>

      <TextBlock Text="Suggested" FontSize="12" Margin="0,16,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      <WrapPanel x:Name="Swatches" />

      <TextBlock x:Name="BlendWarning" Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                 Foreground="{DynamicResource SystemFillColorCautionBrush}"
                 Text="This color is hard to tell apart from the free space next to it in the tray." />
    </StackPanel>

    <Border Grid.Row="2" Padding="20,16" Background="{DynamicResource LayerFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
      <Grid>
        <ui:Button x:Name="UseUsual" Content="Use the usual color" Click="OnUseUsual" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <ui:Button Content="Cancel" MinWidth="88" IsCancel="True" />
          <ui:Button x:Name="Ok" Content="OK" MinWidth="88" Margin="8,0,0,0" Appearance="Primary" IsDefault="True" Click="OnOk" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</ui:FluentWindow>
