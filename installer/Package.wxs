<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <!-- Never change the UpgradeCode: it's how a new version finds and replaces the old one. -->
  <Package Name="DiskTray" Manufacturer="DiskTray" Version="$(Version)" Scope="perMachine"
           UpgradeCode="e048c4d3-96be-41df-9c0a-9ae7059d2735">
    <!-- Same-version upgrades too, so a rebuilt MSI replaces the installed one rather than
         installing beside it. -->
    <!-- The old version comes out inside this install's own script, so a failed upgrade
         puts it back, and only once the new files are in place. Removing it any earlier,
         straight after InstallInitialize, means nothing may be queued before it, and closing
         other users' copies (CloseOtherSessions) queues its work there, so every upgrade
         failed (error 2613). New files replace old ones by version, and every release
         raises it. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" Schedule="afterInstallExecute"
                  DowngradeErrorMessage="A newer version of DiskTray is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Settings › Apps: the icon, and only Uninstall (there's nothing to change or repair). -->
    <Icon Id="DiskTray.ico" SourceFile="..\src\DiskTray.App\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="DiskTray.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="DiskTray" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <!-- DiskTray.exe on its own, so the Start menu shortcut can belong to it. -->
      <Component>
        <File Source="$(PublishDir)DiskTray.exe">
          <Shortcut Name="DiskTray" Description="WSL and Docker disk usage" Directory="ProgramMenuFolder"
                    WorkingDirectory="INSTALLFOLDER" Advertise="no" />
        </File>
      </Component>
      <Files Include="$(PublishDir)**">
        <Exclude Files="$(PublishDir)DiskTray.exe" />
        <Exclude Files="$(PublishDir)**\*.pdb" />
      </Files>
    </ComponentGroup>

    <Feature Id="Main">
      <ComponentGroupRef Id="AppFiles" />
    </Feature>

    <!-- DiskTray running for other signed-in users, on an upgrade or uninstall: sent a close
         message, then ended if it hasn't gone after 15 s (Windows doesn't pass the message
         to other sessions, so in practice it's ended). Runs as admin, so it reaches every
         session. The installing user's own copy has been closed cleanly by then
         (CloseDiskTray, or RemoveUserData on an uninstall). -->
    <util:CloseApplication Id="CloseOtherSessions" Target="DiskTray.exe" ElevatedCloseMessage="yes" ElevatedEndSessionMessage="yes"
                           TerminateProcess="1" Timeout="15" RebootPrompt="no" Condition="Installed OR WIX_UPGRADE_DETECTED" />

    <!-- A Compactor running, in any signed-in user's session, means a clean up is compacting
         a disk or about to. Ending it part way, or replacing it, would leave that disk half
         done, so the install stops instead (and DiskTray starts again, below). -->
    <util:CloseApplication Id="CompactorRunning" Target="DiskTray.Compactor.exe" Property="COMPACTORRUNNING" RebootPrompt="no" />
    <CustomAction Id="StopWhileCompacting"
                  Error="A DiskTray clean up is compacting a disk, or about to (perhaps for another signed-in user), so DiskTray can't be upgraded or removed right now. Try again once it's done." />

    <!-- These run as the user doing the install, without admin rights, in their session. -->

    <!-- On an uninstall (not an upgrade): close DiskTray and remove the user's settings,
         Startup apps entry and notification registration, which only DiskTray knows about.
         Deferred, so it only runs once the uninstall is under way, after the admin prompt;
         impersonated, so it runs as that user. -->
    <CustomAction Id="RemoveUserData" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="yes" Return="ignore"
                  ExeCommand="&quot;[INSTALLFOLDER]DiskTray.exe&quot; --remove-user-data" />
    <!-- On an upgrade or a repair: close the running copy so its files can be replaced. -->
    <CustomAction Id="CloseDiskTray" Directory="INSTALLFOLDER" Execute="immediate" Return="ignore"
                  ExeCommand="&quot;[INSTALLFOLDER]DiskTray.exe&quot; --exit" />
    <!-- After installing: close whatever copy is still running, wherever it's from (a copy
         that was never installed, say), so the new one doesn't find it and quit. -->
    <CustomAction Id="CloseAnyCopy" Directory="INSTALLFOLDER" Execute="immediate" Return="ignore"
                  ExeCommand="&quot;[INSTALLFOLDER]DiskTray.exe&quot; --exit" />
    <!-- Then start it the way Explorer does, so it never runs as admin even when the install
         did. Not for a silent first install, nor for any install run as SYSTEM (by a
         management tool), which have no one to see it; but after a silent upgrade a user
         started (winget, say), since DiskTray was closed for it. -->
    <CustomAction Id="StartDiskTray" Directory="INSTALLFOLDER" Execute="immediate" Return="asyncNoWait"
                  ExeCommand="&quot;[WindowsFolder]explorer.exe&quot; &quot;[INSTALLFOLDER]DiskTray.exe&quot;" />
    <!-- And the same when an upgrade or repair that closed it doesn't finish: cancelled (at
         the "files in use" question, say), stopped by a running Compactor, or failed and
         rolled back, which leaves the old version in place to start. Windows Installer runs
         these as the install ends, one for each way it can end without finishing. -->
    <CustomAction Id="StartDiskTrayAfterCancel" Directory="INSTALLFOLDER" Execute="immediate" Return="asyncNoWait"
                  ExeCommand="&quot;[WindowsFolder]explorer.exe&quot; &quot;[INSTALLFOLDER]DiskTray.exe&quot;" />
    <CustomAction Id="StartDiskTrayAfterError" Directory="INSTALLFOLDER" Execute="immediate" Return="asyncNoWait"
                  ExeCommand="&quot;[WindowsFolder]explorer.exe&quot; &quot;[INSTALLFOLDER]DiskTray.exe&quot;" />

    <InstallExecuteSequence>
      <Custom Action="CloseDiskTray" Before="InstallValidate"
              Condition="(Installed OR WIX_UPGRADE_DETECTED) AND NOT REMOVE~=&quot;ALL&quot;" />
      <!-- Straight after InstallInitialize, in this order, before any file is changed.
           RemoveUserData (on an uninstall) and the closing of other sessions' copies are
           deferred: they're queued here and only run once the install is under way, so
           after the check for a running Compactor, which stops the install before either
           has run. -->
      <Custom Action="RemoveUserData" After="InstallInitialize"
              Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="override Wix4CloseApplications_X64" After="RemoveUserData" />
      <Custom Action="StopWhileCompacting" After="Wix4CloseApplications_X64" Condition="COMPACTORRUNNING" />
      <Custom Action="CloseAnyCopy" After="InstallFinalize"
              Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="StartDiskTray" After="CloseAnyCopy"
              Condition="NOT REMOVE~=&quot;ALL&quot; AND (UILevel &gt; 2 OR WIX_UPGRADE_DETECTED) AND UserSID &lt;&gt; &quot;S-1-5-18&quot;" />
      <!-- Wherever CloseDiskTray ran, so it was closed; not for an install run as SYSTEM. -->
      <Custom Action="StartDiskTrayAfterCancel" OnExit="cancel"
              Condition="(Installed OR WIX_UPGRADE_DETECTED) AND NOT REMOVE~=&quot;ALL&quot; AND UserSID &lt;&gt; &quot;S-1-5-18&quot;" />
      <Custom Action="StartDiskTrayAfterError" OnExit="error"
              Condition="(Installed OR WIX_UPGRADE_DETECTED) AND NOT REMOVE~=&quot;ALL&quot; AND UserSID &lt;&gt; &quot;S-1-5-18&quot;" />
    </InstallExecuteSequence>
  </Package>
</Wix>
