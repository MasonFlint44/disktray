<Project Sdk="Microsoft.NET.Sdk">
  <!-- WPF tray app: icons, flyout, Settings, Clean up, toasts. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 SDK version brings in the WinRT APIs that toast notifications use. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>DiskTray</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Drawn by AppIcon. Running DiskTray.exe with render-icons writes a fresh copy. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- LibraryImport generates unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../DiskTray.Core/DiskTray.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- The pipe to the Compactor and the folder check are tested on Windows. -->
    <InternalsVisibleTo Include="DiskTray.Windows.Tests" />
  </ItemGroup>
</Project>
