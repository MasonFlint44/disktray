<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for the Windows-only parts that matter for running as admin: the pipe between the
       app and the Compactor, the Compactor's path and account checks, the compact itself and
       the app's check of the Compactor's folder. Real files, pipes and processes, in temp
       folders only. Runs on Windows (the GitHub Actions build); some tests need admin and
       are skipped without it. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <!-- LibraryImport generates unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Builds anywhere, but only Windows can run it, so `dotnet test` elsewhere leaves it out. -->
    <IsTestProject Condition="!$([MSBuild]::IsOSPlatform('Windows'))">false</IsTestProject>
    <IsTestingPlatformApplication Condition="!$([MSBuild]::IsOSPlatform('Windows'))">false</IsTestingPlatformApplication>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/DiskTray.Core/DiskTray.Core.csproj" />
    <ProjectReference Include="../../src/DiskTray.App/DiskTray.App.csproj" />
    <ProjectReference Include="../../src/DiskTray.Compactor/DiskTray.Compactor.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
