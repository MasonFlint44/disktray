<ui:FluentWindow x:Class="DiskTray.App.CleanupWindow"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Clean up"
                 Width="560"
                 SizeToContent="Height"
                 MaxHeight="900"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 FontFamily="Segoe UI Variable Text, Segoe UI"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <ui:FluentWindow.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Padding" Value="16" />
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="StepTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Secondary" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Size" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="12,0,0,0" />
    </Style>
    <!-- One half of the "When" switch: looks like a button, acts like a radio button. -->
    <Style x:Key="Segment" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Margin" Value="0" />
    </Style>
  </ui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar x:Name="TitleBar" Title="Clean up" ShowMaximize="False" ShowMinimize="False"
                 Icon="{ui:ImageIcon 'pack://application:,,,/app.ico', Width=16, Height=16}" />

    <ScrollViewer x:Name="Body" Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,8,24,12">
        <ui:InfoBar x:Name="DryRunBar" Margin="0,0,0,12" IsOpen="True" IsClosable="False" Severity="Informational"
                    Title="Dry run" Visibility="Collapsed"
                    Message="Nothing gets changed. Each step is only written to the log, and the Compactor still asks for admin so that step can be tried too." />

        <!-- Step 1: prune Docker -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <CheckBox x:Name="Prune" Checked="OnChanged" Unchecked="OnChanged" VerticalContentAlignment="Top">
                <StackPanel>
                  <TextBlock Text="Prune Docker" Style="{StaticResource StepTitle}" />
                  <TextBlock x:Name="PruneDetail" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
                </StackPanel>
              </CheckBox>
              <TextBlock x:Name="PruneTotal" Grid.Column="1" Style="{StaticResource Size}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Top" />
            </Grid>

            <StackPanel x:Name="Checking" Orientation="Horizontal" Margin="30,10,0,0">
              <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0" />
              <TextBlock Text="Checking what Docker can prune…" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
            </StackPanel>

            <ui:Button x:Name="DetailsButton" Content="Choose what to remove" Margin="30,10,0,0" Padding="10,4"
                       FontSize="12" Click="OnDetailsClick" Visibility="Collapsed" />

            <StackPanel x:Name="Details" Margin="30,12,0,0" Visibility="Collapsed">
              <Grid Margin="0,0,0,6">
                <CheckBox x:Name="BuildCache" Content="Build cache" Checked="OnChanged" Unchecked="OnChanged" />
                <TextBlock x:Name="BuildCacheSize" Style="{StaticResource Size}" />
              </Grid>
              <Grid>
                <CheckBox x:Name="DanglingImages" Content="Dangling images" Checked="OnChanged" Unchecked="OnChanged" />
                <TextBlock x:Name="DanglingImagesSize" Style="{StaticResource Size}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </Grid>
              <Border Height="1" Margin="0,12" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
              <TextBlock Text="Unused volumes" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,2" />
              <TextBlock Text="Only volumes from projects whose folder is gone are picked for you."
                         Style="{StaticResource Secondary}" Margin="0,0,0,4" />
              <TextBlock x:Name="NoVolumes" Text="None" Style="{StaticResource Secondary}" Margin="0,4,0,0" Visibility="Collapsed" />
              <StackPanel x:Name="VolumeGroups" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Step 2: compact the disks -->
        <Border Style="{StaticResource Card}" Margin="0">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <CheckBox x:Name="Compact" Checked="OnChanged" Unchecked="OnChanged" VerticalContentAlignment="Top">
                <StackPanel>
                  <TextBlock Text="Compact disks" Style="{StaticResource StepTitle}" />
                  <TextBlock x:Name="CompactDetail" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
                </StackPanel>
              </CheckBox>
              <TextBlock x:Name="CompactGain" Grid.Column="1" Style="{StaticResource Size}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Top" />
            </Grid>

            <StackPanel x:Name="CompactOptions" Margin="30,12,0,0">
              <Grid AutomationProperties.Name="When to compact">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="4" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <RadioButton x:Name="WhenIdle" GroupName="When" Content="When WSL is idle" Style="{StaticResource Segment}"
                             Checked="OnWhenChanged" />
                <RadioButton x:Name="RightAway" Grid.Column="2" GroupName="When" Content="Right away" Style="{StaticResource Segment}"
                             Checked="OnWhenChanged" />
              </Grid>

              <TextBlock x:Name="IdleNote" Style="{StaticResource Secondary}" Margin="0,10,0,0" LineHeight="18" />
              <Border x:Name="Warning" Margin="0,10,0,0" Padding="12" CornerRadius="6" Visibility="Collapsed"
                      Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                <StackPanel x:Name="WarningLines" />
              </Border>

              <TextBlock Text="Takes about 10–20 min · asks for admin" Style="{StaticResource Secondary}" Margin="0,10,0,0"
                         Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              <CheckBox x:Name="StartDocker" Content="Start Docker Desktop afterwards" Margin="0,8,0,0" FontSize="13"
                        Checked="OnChanged" Unchecked="OnChanged" Click="OnStartDockerClick" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Padding="24,16" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            Background="{DynamicResource LayerOnMicaBaseAltFillColorDefaultBrush}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock x:Name="Summary" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="Plan" Style="{StaticResource Secondary}" Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <ui:Button x:Name="CancelButton" Content="Cancel" Width="96" Height="36" Margin="0,0,8,0" IsCancel="True" Click="OnCancelClick" />
          <ui:Button x:Name="Start" Content="Clean up" Width="120" Height="36" Appearance="Primary" Click="OnStartClick" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</ui:FluentWindow>
